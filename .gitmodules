[submodule "third_party/eigen"]
	path = third_party/eigen
	url = https://github.com/eigen-mirror/eigen.git
[submodule "third_party/opencv"]
	path = third_party/opencv
	url = https://github.com/opencv/opencv.git
	# The sparse checkout (scripts/sparse-opencv.sh, cmake/SemperOpenCV.cmake)
	# plants stub doc/ and data/ CMakeLists.txt files in it.
	ignore = untracked
